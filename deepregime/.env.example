# ============================================================
# .env.example
# Copy this to .env and fill in your API keys
# ============================================================

# ── App ────────────────────────────────────────────────────
APP_NAME="DeepRegime AI"
DEBUG=False
SECRET_KEY=your-secret-key-here-change-in-production

# ── Database ───────────────────────────────────────────────
# SQLite (development)
DATABASE_URL=sqlite+aiosqlite:///database/market_regime.db

# PostgreSQL (production) — uncomment and fill:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/market_regime

# ── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Market Data APIs ───────────────────────────────────────
# Free tier: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# Free tier: https://finnhub.io/register
FINNHUB_API_KEY=

# Free tier: https://newsapi.org/register
NEWS_API_KEY=

# Polygon.io (premium): https://polygon.io/
POLYGON_API_KEY=

# ── Model Configuration ────────────────────────────────────
HMM_N_COMPONENTS=6
HMM_N_ITER=200
LSTM_LOOKBACK_DAYS=60
LSTM_HIDDEN_UNITS=128
LSTM_DROPOUT=0.2
LSTM_EPOCHS=100
LSTM_BATCH_SIZE=32

# ── Backtesting ────────────────────────────────────────────
BACKTEST_START_DATE=2015-01-01
INITIAL_CAPITAL=1000000
TRANSACTION_COST_BPS=10

# ── Data Refresh ───────────────────────────────────────────
LIVE_DATA_INTERVAL_SECONDS=60
REGIME_DETECTION_INTERVAL_SECONDS=300
PORTFOLIO_REBALANCE_INTERVAL_HOURS=24
